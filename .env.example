# Gemini API Key (Used by @google/genai Interactions API for gemini-4-argon)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Maps Platform API Key (Used for live Street View Static / Panorama & Metadata API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Server Port (Cloud Run defaults to 8080)
PORT=8080
